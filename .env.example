# ─── GitHub Copilot (AI provider) ─────────────────────────────────────────────
# GitHub personal access token with Copilot scope.
#
# This is OPTIONAL if you have already authenticated on the host machine:
#   • gh auth login   (GitHub CLI)
#   • copilot login   (Copilot CLI)
# Both store an OAuth token in ~/.config/github-copilot/hosts.json which
# NanoClaw reads automatically.
#
# Set this only if you prefer to supply a token explicitly, or if the
# auto-discovery above doesn't work in your environment.
# Obtain a token by running:  npm run copilot-auth
# Requires an active GitHub Copilot subscription.
# GITHUB_TOKEN=

# (Optional) Override the Copilot model. Defaults to gpt-4o.
# Other options: claude-3.5-sonnet, o3-mini (availability depends on your plan)
# COPILOT_MODEL=gpt-4o

# (Optional) Override the GitHub OAuth app client ID used for device-code auth.
# The default works for most users.
# GITHUB_OAUTH_CLIENT_ID=Iv1.b507a08c87ecfe98

# ─── Assistant ────────────────────────────────────────────────────────────────
# Name used to trigger the assistant and in responses.
# ASSISTANT_NAME=Andy

# ─── Container ────────────────────────────────────────────────────────────────
# CONTAINER_IMAGE=nanoclaw-agent:latest
# CONTAINER_TIMEOUT=1800000
# MAX_CONCURRENT_CONTAINERS=5
# IDLE_TIMEOUT=1800000

# ─── Timezone ─────────────────────────────────────────────────────────────────
# TZ=America/New_York
